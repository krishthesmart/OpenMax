# ───────── OpenMax configuration ─────────
# Copy to .env and fill in. Every value is optional; OpenMax degrades gracefully.

# Server
PORT=8787
HOST=127.0.0.1                 # use 0.0.0.0 only behind a trusted network, and set OPENMAX_PASSWORD
OPENMAX_PASSWORD=              # if set, /api/* requires "Authorization: Bearer <password>"
DATA_DIR=                      # default ./data

# ── Free cloud providers (enabled by default) ──
ALLOW_FREE_CLOUD=true
NVIDIA_API_KEY=                # https://build.nvidia.com
GEMINI_API_KEY=                # https://aistudio.google.com
OPENROUTER_API_KEY=            # https://openrouter.ai/keys  (":free" models only unless ENABLE_PAID)
GROQ_API_KEY=                  # https://console.groq.com

# ── Local ──
OLLAMA_URL=http://127.0.0.1:11434

# ── Paid flagships (hidden unless ENABLE_PAID=true) ──
ENABLE_PAID=false
MONTHLY_BUDGET_USD=20          # warn at 80%, auto-switch to free/local at 100%
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_PAID_API_KEY=
DEEPSEEK_API_KEY=
META_API_KEY=
META_BASE_URL=https://api.llama.com/compat/v1

# ── Search ──
SEARCH_BACKEND=auto            # auto (SearXNG if running, else Brave if keyed, else DuckDuckGo) | searxng | brave | duckduckgo
SEARXNG_URL=http://127.0.0.1:8080
BRAVE_API_KEY=

# ── Media (Studio) ──
MEDIA_PROVIDER=auto            # auto (ComfyUI if running, else Gemini image when GEMINI_API_KEY is set) | comfy | google-image | fal
COMFY_URL=http://127.0.0.1:8188
FAL_KEY=

# ── Speech ──
TTS_BACKEND=auto               # auto | kokoro | piper | say
KOKORO_URL=http://127.0.0.1:8880/v1
PIPER_BIN=piper
PIPER_MODEL=                   # path to a .onnx voice
WHISPER_BIN=whisper-cli        # whisper.cpp binary
WHISPER_MODEL=                 # path to a ggml model; if empty, Groq hosted Whisper is used when GROQ_API_KEY is set

# ── Code & Agent ──
CODE_WORKSPACE=                # default ./workspace
AGENT_SANDBOX=                 # default ./data/agent/files
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Memory over MCP (optional, your self-hosted MemoryOS) ──
MEMORYOS_URL=                  # e.g. http://localhost:3000/mcp  (can also be set in Settings)

# ── Local cost estimate ──
GPU_WATTS=150
USD_PER_KWH=0.15

